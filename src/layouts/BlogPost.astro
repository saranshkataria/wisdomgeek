---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import AuthorBio from "../components/AuthorBio.astro";
import BaseHead from "../components/BaseHead.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import PageLayout from "../components/PageLayout.astro";
import PostTags from "../components/PostTags.astro";
import ShareButtons from "../components/ShareButtons.astro";
import { SITE_AUTHOR } from "../consts";
import authors from "../config/authors.json";
import { categoryToSlug, slugToTitle } from "../lib/utils";

type Props = CollectionEntry<"blog">["data"] & {
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
  relatedPosts?: CollectionEntry<"blog">[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author,
  categories,
  categoryHierarchy,
  tags,
  prevPost,
  nextPost,
  relatedPosts,
} = Astro.props;

const displayAuthor = author || SITE_AUTHOR;
const authorData = authors.find((a) => a.name === displayAuthor);

// Category levels of the post's URL, e.g. development/web-development/javascript
const urlCategorySlugs = Astro.url.pathname.split("/").filter(Boolean).slice(0, -1);
const hierarchySlugs = (categoryHierarchy ?? []).map(categoryToSlug);

// Name from categories (WordPress's names) first, then categoryHierarchy for parent levels
const categoryName = (slug: string) =>
  [...(categories ?? []), ...(categoryHierarchy ?? [])].find(
    (name) => categoryToSlug(name) === slug,
  ) ?? slugToTitle(slug);

// Nested category archive, e.g. /development/web-development/javascript/
const categoryHref = (slug: string) => {
  for (const slugs of [urlCategorySlugs, hierarchySlugs]) {
    const index = slugs.indexOf(slug);
    if (index !== -1) return `/${slugs.slice(0, index + 1).join("/")}/`;
  }
  return `/${slug}/`;
};

const breadcrumbs = [
  ...urlCategorySlugs.map((slug, index) => ({
    name: categoryName(slug),
    href: `/${urlCategorySlugs.slice(0, index + 1).join("/")}/`,
  })),
  { name: title },
];

// Compare calendar days, the precision dates are displayed with
const showUpdatedDate =
  updatedDate !== undefined && updatedDate.toDateString() !== pubDate.toDateString();

const currentUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(title);
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      article={true}
      pubDate={pubDate}
      modDate={updatedDate}
      keywords={categories}
    />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }

      /* ── Post header card (gray panel around image + meta) ── */
      .post-header-card {
        background: var(--surface-muted);
        border-radius: 20px;
        padding: 1.25em;
        margin-bottom: 1.5em;
      }

      /* ── Hero image wrapper ── */
      .hero-card-image-wrapper {
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 0;
      }

      /* Hero image with the title on top, stacked in one grid cell: the hero keeps the
         image's shape, and grows (the image covering it) when a long title needs more
         room, e.g. on phones or with wide banner images */
      .hero-card-image {
        position: relative;
        display: grid;
      }
      .hero-card-image > * {
        grid-area: 1 / 1;
      }
      .hero-card-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* Darkens the whole image: on phones the title reaches the top of the image */
      .hero-card-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.6));
        pointer-events: none;
      }

      /* Overlay content at the bottom of the image */
      .hero-overlay {
        align-self: end;
        padding: 1.5em;
        z-index: 1;
      }
      .hero-overlay h1 {
        margin: 0 0 0.5em;
        font-size: 1.6em;
        line-height: 1.25;
        color: white;
        font-weight: 800;
      }

      /* Share icons on image */
      .share-row {
        display: flex;
        align-items: center;
        gap: 1em;
      }
      .share-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.9);
        text-decoration: none;
        transition: color 0.15s;
      }
      .share-btn:hover { color: white; }
      .share-btn svg { width: 26px; height: 26px; }

      /* Meta area below image (on gray panel) */
      .post-meta-area {
        position: relative;
        padding: 0 0.25em 1em;
      }

      /* Avatar overlapping image bottom */
      .avatar-row {
        position: relative;
        height: 28px;
      }
      .author-avatar {
        position: absolute;
        left: 0;
        top: -24px;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--surface);
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      }
      .author-avatar-fallback {
        position: absolute;
        left: 0;
        top: -24px;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
        border: 3px solid var(--surface);
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      }

      /* Meta row */
      .post-meta-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4em;
        font-size: 0.85rem;
        color: rgb(var(--gray));
      }
      .meta-icon {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.3em;
      }
      .meta-icon svg {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
      }
      .post-meta-row a {
        color: rgb(var(--gray-dark));
        text-decoration: none;
      }
      .post-meta-row a:hover { color: var(--accent); }
      .meta-sep {
        margin: 0 0.15em;
        color: rgb(var(--gray-light));
      }
      .category-badge {
        display: inline-block;
        padding: 0.35em 1em;
        background: var(--surface);
        border: none;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
        margin-left: auto;
        transition: background 0.15s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
      }
      .category-badge:hover {
        background: var(--pill-hover);
      }
      .last-updated-on { font-style: italic; }

      /* ── Prose ── */
      .prose {
        color: rgb(var(--gray-dark));
        padding: 0.5em 0.25em;
      }

      /* ── No-image fallback ── */
      .post-card-no-image {
        padding: 1.5em 1.25em 0;
      }
      .post-card-no-image h1 {
        margin: 0 0 0.5em;
        font-size: 1.6em;
        line-height: 1.25;
        color: rgb(var(--black));
      }

      /* ── Post navigation: one bar split into Previous and Next halves, as on the live site ── */
      .post-navigation {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin: 2em 0 1.5em;
        background: var(--surface-muted);
        border-radius: 20px;
      }
      .post-navigation a {
        position: relative;
        padding: 10px 20px 10px 40px;
        font-size: 0.9375rem;
        line-height: 1.5;
        text-decoration: none;
        color: rgb(var(--gray-dark));
      }
      /* Each link keeps its half when the other one is missing */
      .post-navigation .prev { grid-column: 1; }
      .post-navigation .next {
        grid-column: 2;
        padding: 10px 40px 10px 20px;
        border-left: 1px solid rgb(var(--gray-light));
      }
      .post-navigation .nav-label {
        display: block;
        font-size: 0.75rem;
        line-height: 1.875;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: rgb(var(--gray));
      }
      .post-navigation .nav-title {
        display: block;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-weight: 600;
        transition: color 0.2s ease;
      }
      .post-navigation .nav-arrow {
        position: absolute;
        top: 50%;
        width: 18px;
        height: 18px;
        margin-top: -10px;
        color: rgb(var(--gray));
        transition: color 0.2s ease;
      }
      .post-navigation .prev .nav-arrow { left: 10px; }
      .post-navigation .next .nav-arrow { right: 10px; }
      .post-navigation a:hover .nav-title,
      .post-navigation a:hover .nav-arrow {
        color: var(--accent);
      }
      /* Stacked on phones with Next above Previous, as on the live site */
      @media (max-width: 720px) {
        .post-navigation { grid-template-columns: minmax(0, 1fr); }
        .post-navigation .next {
          grid-column: 1;
          grid-row: 1;
          border-left: none;
        }
        .post-navigation .prev:not(:only-child) {
          grid-row: 2;
          border-top: 1px solid rgb(var(--gray-light));
        }
      }

      /* ── Related posts ── */
      .related-posts {
        margin: 0;
        padding: 0.5em 0;
      }
      /* 18px and semi-bold, as on the live site */
      .related-posts h3 {
        margin-bottom: 1em;
        font-size: 1.125rem;
        font-weight: 600;
        color: rgb(var(--gray-dark));
      }
      .related-posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1em;
      }
      .related-post-card {
        border: 1px solid rgb(var(--gray-light));
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        color: rgb(var(--gray-dark));
        transition: all 0.2s ease;
      }
      .related-post-card:hover {
        box-shadow: var(--box-shadow);
        border-color: var(--accent);
      }
      .related-post-card img {
        width: 100%;
        height: 150px;
        object-fit: cover;
      }
      .related-post-content { padding: 1em; }
      .related-post-title {
        font-weight: 800;
        margin-bottom: 0.5em;
        font-size: 0.95rem;
      }
      .related-post-date {
        font-size: 0.875rem;
        color: rgb(var(--gray));
      }

      @media (max-width: 720px) {
        .hero-overlay h1 {
          font-size: 1.2em;
        }
        .hero-overlay {
          padding: 1em;
        }
        .share-btn svg { width: 20px; height: 20px; }
        .category-badge { margin-left: 0; }
        /* The meta row wraps on phones, where a separator would start a line */
        .meta-sep { display: none; }
      }
    </style>
  </head>

  <body>
    <PageLayout>
      <Breadcrumbs crumbs={breadcrumbs} />
      <article>
        <div class="post-header-card">
        {heroImage ? (
          <div class="hero-card-image-wrapper">
            <div class="hero-card-image">
              <Image width={920} height={518} src={heroImage} alt="" />
              <div class="hero-overlay">
                <h1>{title}</h1>
                <div class="share-row">
                  <a href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on X">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                  <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on Facebook">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  </a>
                  <a href={`https://pinterest.com/pin/create/button/?url=${encodedUrl}&description=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on Pinterest">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                  </a>
                  <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on LinkedIn">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <div class="post-card-no-image">
            <h1>{title}</h1>
          </div>
        )}

        <!-- Avatar + meta row on gray panel -->
        <div class="post-meta-area">
          <div class="avatar-row">
            {authorData?.avatar ? (
              <img class="author-avatar" src={authorData.avatar} alt={displayAuthor} />
            ) : (
              <div class="author-avatar-fallback">{displayAuthor.charAt(0)}</div>
            )}
          </div>
          <div class="post-meta-row">
            <span class="meta-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <FormattedDate date={pubDate} />
              {showUpdatedDate && (
                <span class="last-updated-on">
                  &middot; Updated <FormattedDate date={updatedDate} />
                </span>
              )}
            </span>
            <span class="meta-sep">|</span>
            <span class="meta-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <a href="/author/saranshkataria">{displayAuthor}</a>
            </span>
            {categories && categories.length > 0 && (
              <a href={categoryHref(categoryToSlug(categories[0]))} class="category-badge" style="color: var(--pill-text); text-decoration: none;">
                {categories[0]}
              </a>
            )}
          </div>
        </div>
        </div>

        <div class="prose">
          <slot />
        </div>

        <PostTags tags={tags} />

        <!-- Author Bio -->
        <AuthorBio authorName={displayAuthor} />

        <!-- Share buttons -->
        <ShareButtons url={currentUrl} title={title} />

        <!-- Previous/Next Navigation -->
        {
          (prevPost || nextPost) && (
            <nav class="post-navigation" aria-label="Previous and next posts">
              {prevPost && (
                <a href={`/${prevPost.id}/`} class="prev" rel="prev">
                  <svg class="nav-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3l-9 9 9 9" /></svg>
                  <span class="nav-label">Previous</span> <span class="nav-title">{prevPost.data.title}</span>
                </a>
              )}
              {nextPost && (
                <a href={`/${nextPost.id}/`} class="next" rel="next">
                  <span class="nav-label">Next</span> <span class="nav-title">{nextPost.data.title}</span>
                  <svg class="nav-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3l9 9-9 9" /></svg>
                </a>
              )}
            </nav>
          )
        }

        <!-- Related Posts -->
        {
          relatedPosts && relatedPosts.length > 0 && (
            <section class="related-posts">
              <h3>You may also like...</h3>
              <div class="related-posts-grid">
                {relatedPosts.map((relatedPost) => (
                  <a href={`/${relatedPost.id}/`} class="related-post-card">
                    {relatedPost.data.heroImage && (
                      <Image
                        width={300}
                        height={150}
                        src={relatedPost.data.heroImage}
                        alt={relatedPost.data.title}
                      />
                    )}
                    <div class="related-post-content">
                      <div class="related-post-title">
                        {relatedPost.data.title}
                      </div>
                      <div class="related-post-date">
                        <FormattedDate date={relatedPost.data.pubDate} />
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </article>
    </PageLayout>

    <script>
      // Copy buttons for code blocks; created here so they only exist when they can work
      const icons =
        '<svg class="icon-copy" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>' +
        '<svg class="icon-check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

      if (navigator.clipboard) {
        for (const block of document.querySelectorAll(".code-block")) {
          const code = block.querySelector("pre code");
          const bar = block.querySelector(".code-bar");
          if (!code || !bar) continue;

          const button = document.createElement("button");
          button.type = "button";
          button.className = "code-copy";
          button.setAttribute("aria-label", "Copy");
          button.innerHTML = icons;

          let resetTimer: number | undefined;
          button.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(code.textContent ?? "");
            } catch {
              return;
            }
            button.dataset.copied = "";
            button.setAttribute("aria-label", "Copied");
            clearTimeout(resetTimer);
            resetTimer = window.setTimeout(() => {
              delete button.dataset.copied;
              button.setAttribute("aria-label", "Copy");
            }, 2000);
          });

          bar.append(button);
        }
      }
    </script>
  </body>
</html>
