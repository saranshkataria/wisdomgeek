---
import { type CollectionEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { buildCategoryTree, sortCategoryTree } from '../lib/utils';

const posts = await getCollection('blog');

// Category tree from categoryPaths, with real names and post counts like the live sidebar
const categoryTree = buildCategoryTree(posts);
const sortedCategoryTree = sortCategoryTree(categoryTree);

// Get featured posts
const featuredPosts = posts
	.filter(post => post.data.categoryPaths?.includes('featured'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get recent posts
const recentPosts = posts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

// Linked categories of a post, shown as "Featured / JavaScript" like on the live sidebar
const categoryLinks = (post: CollectionEntry<'blog'>) =>
	(post.data.categories ?? []).flatMap((name, i) => {
		const path = post.data.categoryPaths?.[i];
		return path ? [{ name, href: `/${path}/` }] : [];
	});
---

<aside class="sidebar">
	<!-- Recent Posts -->
	<div class="sidebar-section">
		<h3>Recent Posts</h3>
		<div class="recent-posts">
			{recentPosts.map((post) => (
				<div class="recent-post">
					{post.data.heroImage && (
						<a href={`/${post.id}/`} class="recent-post-thumbnail-link">
							<Image 
								width={48} 
								height={48} 
								densities={[1, 2]}
								src={post.data.heroImage} 
								alt={post.data.title}
								class="recent-post-thumbnail"
							/>
						</a>
					)}
					<div class="recent-post-content">
						<p class="post-categories">
							{categoryLinks(post).map((category, i) => (
								<>{i > 0 && ' / '}<a href={category.href}>{category.name}</a></>
							))}
						</p>
						<a href={`/${post.id}/`} class="recent-post-title-link">
							<h4 class="recent-post-title">{post.data.title}</h4>
						</a>
						<p class="recent-post-date">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</div>
				</div>
			))}
		</div>
	</div>

	<!-- Category Map -->
	<div class="sidebar-section">
		<h3>Categories</h3>
		<ul class="category-list">
			{sortedCategoryTree.map((category) => (
				<li>
					<a href={`/${category.path}/`}>
						<span class="category-name">{category.name}</span>
						<span class="category-count">({category.count})</span>
					</a>
					{category.children.size > 0 && (
						<ul class="category-sublist">
							{sortCategoryTree(category.children).map((subCategory) => (
								<li>
									<a href={`/${subCategory.path}/`}>
										<span class="category-name">{subCategory.name}</span>
										<span class="category-count">({subCategory.count})</span>
									</a>
									{subCategory.children.size > 0 && (
										<ul class="category-sublist">
											{sortCategoryTree(subCategory.children).map((subSubCategory) => (
												<li>
													<a href={`/${subSubCategory.path}/`}>
														<span class="category-name">{subSubCategory.name}</span>
														<span class="category-count">({subSubCategory.count})</span>
													</a>
												</li>
											))}
										</ul>
									)}
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
	</div>

	<!-- Featured Posts -->
	{featuredPosts.length > 0 && (
		<div class="sidebar-section">
			<h3>Featured Posts</h3>
			<div class="featured-posts">
				{featuredPosts.map((post) => (
					<div class="featured-post">
						{post.data.heroImage && (
							<a href={`/${post.id}/`} class="featured-thumbnail-link">
								<Image 
									width={300} 
									height={150} 
									src={post.data.heroImage} 
									alt={post.data.title}
									class="featured-thumbnail"
								/>
							</a>
						)}
						<p class="post-categories">
							{categoryLinks(post).map((category, i) => (
								<>{i > 0 && ' / '}<a href={category.href}>{category.name}</a></>
							))}
						</p>
						<a href={`/${post.id}/`} class="featured-title-link">
							<h4 class="featured-title">{post.data.title}</h4>
						</a>
						<p class="featured-date">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</div>
				))}
			</div>
		</div>
	)}
</aside>

<style>
	/* Flat column as on the live site: a rule along its full height separates it from the content */
	.sidebar {
		box-sizing: border-box;
		width: 100%;
		min-height: 100%;
		padding-left: 30px;
		border-left: 1px solid rgb(var(--gray-light));
	}

	.sidebar-section {
		margin-bottom: 40px;
	}

	/* The title sits on a thin rule that starts at the column's border: "─ Categories ───" */
	.sidebar-section h3 {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 30px -30px;
		font-size: 1rem;
		line-height: 1.3;
		letter-spacing: normal;
		color: rgba(var(--black), 70%);
	}

	.sidebar-section h3::before,
	.sidebar-section h3::after {
		content: '';
		height: 1px;
		background-color: rgb(var(--gray-light));
	}

	.sidebar-section h3::before {
		flex: 0 0 20px;
	}

	.sidebar-section h3::after {
		flex: 1;
	}

	/* Compact rows as on the live sidebar: 14px text, 7px above and below */
	.category-list {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.category-list li {
		padding: 7px 0;
	}

	.category-sublist {
		list-style: none;
		margin: 0;
		padding-left: 15px;
	}

	/* The parent row's bottom padding closes the group */
	.category-sublist li {
		padding-bottom: 0;
	}

	.category-list a {
		text-decoration: none;
		color: rgb(var(--gray-dark));
		font-weight: 300;
		transition: color 0.2s ease;
	}

	.category-list a:hover {
		color: var(--accent);
	}

	.category-count {
		color: rgb(var(--gray));
	}

	/* Compact rows as on the live sidebar: a 48px thumbnail beside category, title and date */
	.recent-post {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding: 7px 0;
		font-size: 0.875rem;
		line-height: 1.4em;
	}

	.recent-post-thumbnail-link {
		flex-shrink: 0;
		transition: opacity 0.2s ease;
	}

	.recent-post :global(.recent-post-thumbnail) {
		display: block;
		width: 48px;
		height: 48px;
		object-fit: cover;
		border-radius: 10px;
	}

	.recent-post-content {
		flex: 1;
		min-width: 0;
	}

	.post-categories {
		margin: 0;
		font-size: 0.625rem;
		color: rgb(var(--gray));
	}

	.post-categories a {
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.post-categories a:hover {
		color: rgb(var(--black));
	}

	.recent-post-title-link,
	.featured-title-link {
		text-decoration: none;
	}

	.recent-post-title,
	.featured-title {
		margin: 2px 0;
		font-size: 0.875rem;
		line-height: inherit;
		letter-spacing: normal;
		color: rgb(var(--gray-dark));
		transition: color 0.2s ease;
	}

	.recent-post-date,
	.featured-date {
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 400;
		color: rgb(var(--gray));
	}

	/* Featured posts keep a large image, with 13px category and date lines */
	.featured-post {
		padding: 7px 0;
		font-size: 0.875rem;
		line-height: 1.4em;
	}

	.featured-thumbnail-link {
		display: block;
		margin-bottom: 10px;
		transition: opacity 0.2s ease;
	}

	.featured-post :global(.featured-thumbnail) {
		display: block;
		width: 100%;
		height: 150px;
		object-fit: cover;
		border-radius: 10px;
	}

	.featured-post .post-categories {
		font-size: 0.8125rem;
	}

	.featured-title {
		font-size: 1.125rem;
		line-height: 1.4em;
	}

	/* As on the live sidebar, hovering a post fades its image and colors its title */
	.recent-post:hover .recent-post-thumbnail-link,
	.featured-post:hover .featured-thumbnail-link {
		opacity: 0.75;
	}

	.recent-post:hover .recent-post-title,
	.featured-post:hover .featured-title {
		color: var(--accent);
	}

	/* Below the content on narrow screens: no column rule, titles start at the text */
	@media (max-width: 960px) {
		.sidebar {
			margin-top: 2em;
			padding-left: 0;
			border-left: none;
		}

		.sidebar-section h3 {
			margin-left: 0;
		}

		.sidebar-section h3::before {
			display: none;
		}
	}
</style>
