---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { categoryToSlug, decodeHtmlEntities } from '../lib/utils';
import { SITE_AUTHOR } from '../consts';
import authors from '../config/authors.json';

interface Props {
	posts: any[];
}

const { posts } = Astro.props;
---

<ul class="post-grid">
	{
		posts.map((post) => {
			const displayAuthor = post.data.author || SITE_AUTHOR;
			const authorData = authors.find((a) => a.name === displayAuthor);
			return (
				<li>
					<article class="post-card">
						{post.data.heroImage && (
							<a href={`/${post.id}/`} class="post-card-image-link" aria-label={post.data.title}>
								<div class="post-card-image-wrapper">
									<Image width={720} height={400} src={post.data.heroImage} alt="" />
								</div>
							</a>
						)}
						<div class="post-card-body">
							<div class="post-card-avatar-row">
								{authorData?.avatar ? (
									<img class="post-card-avatar" src={authorData.avatar} alt={displayAuthor} />
								) : (
									<div class="post-card-avatar-fallback">{displayAuthor.charAt(0)}</div>
								)}
							</div>
							<a href={`/${post.id}/`} class="post-card-title-link">
								<h2 class="post-card-title">{post.data.title}</h2>
							</a>
							<p class="post-card-date">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
									<line x1="16" y1="2" x2="16" y2="6" />
									<line x1="8" y1="2" x2="8" y2="6" />
									<line x1="3" y1="10" x2="21" y2="10" />
								</svg>
								<FormattedDate date={post.data.pubDate} />
							</p>
							{post.data.description && (
								<p class="post-card-description">{decodeHtmlEntities(post.data.description)}</p>
							)}
							{post.data.categories && post.data.categories.length > 0 && (
								<a href={`/${categoryToSlug(post.data.categories[0])}/`} class="post-card-category">
									{post.data.categories[0]}
								</a>
							)}
						</div>
					</article>
				</li>
			);
		})
	}
</ul>

<style>
	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-card {
		background: #f0f2f5;
		border-radius: 20px;
		padding: 1.25em;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.post-card-image-link {
		display: block;
		text-decoration: none;
	}

	.post-card-image-wrapper {
		border-radius: 16px;
		overflow: hidden;
		transition: transform 0.2s ease;
	}

	.post-card-image-wrapper :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.post-card-image-link:hover .post-card-image-wrapper {
		transform: translateY(-2px);
	}

	.post-card-body {
		position: relative;
		padding: 0 0.25em;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.post-card-avatar-row {
		position: relative;
		height: 28px;
	}

	.post-card-avatar,
	.post-card-avatar-fallback {
		position: absolute;
		left: 0;
		top: -28px;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: 3px solid white;
		box-shadow: 0 0 0 2px #6c5dd3, 0 2px 6px rgba(0, 0, 0, 0.15);
	}

	.post-card-avatar {
		object-fit: cover;
	}

	.post-card-avatar-fallback {
		background: linear-gradient(135deg, #667eea, #764ba2);
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 1.1rem;
	}

	.post-card-title-link {
		text-decoration: none;
		color: inherit;
	}

	.post-card-title {
		margin: 0 0 0.5em;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
		color: rgb(var(--black));
		transition: color 0.15s ease;
	}

	.post-card-title-link:hover .post-card-title {
		color: var(--accent);
	}

	.post-card-date {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		margin: 0 0 0.75em;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}

	.post-card-date svg {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
	}

	.post-card-description {
		margin: 0 0 1em;
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card-category {
		align-self: flex-start;
		margin-top: auto;
		padding: 0.35em 1em;
		background: white;
		color: #4361ee;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
		transition: background 0.15s ease;
	}

	.post-card-category:hover {
		background: #e8ebfa;
	}

	@media (max-width: 720px) {
		.post-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
		.post-card-title {
			font-size: 1.25rem;
		}
	}
</style>
