---
import type { Page } from 'astro';
import { getPageUrl } from '../lib/utils';

interface Props {
	page: Page;
}

const { page } = Astro.props;
// URL of the archive's first page, e.g. "/" or "/development/"
const base = page.url.first ?? page.url.current;

const { currentPage, lastPage } = page;

// Five page numbers picked like WP-PageNavi on the live site: from two pages
// before the current one, shifted back at the end of the archive
const pagesToShow = 5;
let startPage = Math.max(1, currentPage - 2);
let endPage = startPage + pagesToShow - 1;
if (endPage > lastPage) {
	endPage = lastPage;
	startPage = Math.max(1, lastPage - pagesToShow + 1);
}

const showPages: number[] = [];
for (let i = startPage; i <= endPage; i++) {
	showPages.push(i);
}

// As on the live site, "« ..." leads back to page 1 once it has left the
// numbers, and "... Last" leads to the last page while it isn't among them
const showFirst = startPage > 1;
const showLast = endPage < lastPage;
---

{page.lastPage > 1 && (
	<nav class="pagination" aria-label="Pagination">
		<div class="pagination-info">
			<svg class="document-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" fill="currentColor">
				<path d="M224 136V0H24C10.7 0 0 10.7 0 24v464c0 13.3 10.7 24 24 24h336c13.3 0 24-10.7 24-24V160H248c-13.2 0-24-10.8-24-24zm64 236c0 6.6-5.4 12-12 12H108c-6.6 0-12-5.4-12-12v-8c0-6.6 5.4-12 12-12h168c6.6 0 12 5.4 12 12v8zm0-64c0 6.6-5.4 12-12 12H108c-6.6 0-12-5.4-12-12v-8c0-6.6 5.4-12 12-12h168c6.6 0 12 5.4 12 12v8zm0-72v8c0 6.6-5.4 12-12 12H108c-6.6 0-12-5.4-12-12v-8c0-6.6 5.4-12 12-12h168c6.6 0 12 5.4 12 12zm96-114.1v6.1H256V0h6.1c6.4 0 12.5 2.5 17 7l97.9 98c4.5 4.5 7 10.6 7 16.9z"/>
			</svg>
			<span>Page {currentPage} of {lastPage}</span>
		</div>

		<div class="page-numbers">
			{showFirst && (
				<>
					<a href={getPageUrl(base, 1)} class="page-number" aria-label="Go to first page">&laquo;</a>
					<span class="page-dots" aria-hidden="true">...</span>
				</>
			)}

			{showPages.map((num) =>
				num === currentPage ? (
					<span class="page-number current" aria-current="page">{num}</span>
				) : (
					<a href={getPageUrl(base, num)} class="page-number" aria-label={`Go to page ${num}`}>{num}</a>
				)
			)}

			{showLast && (
				<>
					<span class="page-dots" aria-hidden="true">...</span>
					<a href={getPageUrl(base, lastPage)} class="page-number" aria-label="Go to last page">Last</a>
				</>
			)}
		</div>
	</nav>
)}

<style>
	/* Measured on the live site (WP-PageNavi): round 38px buttons with 2px gaps */
	.pagination {
		/* 30px below the post cards */
		margin-top: 30px;
		line-height: 20px;
	}

	.pagination-info {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 9px 14px;
		margin-bottom: 1rem;
		color: rgb(var(--gray));
		font-size: 1rem;
		font-weight: 400;
	}

	.document-icon {
		width: 12px;
		height: 16px;
		flex-shrink: 0;
	}

	.page-numbers {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 10px 2px;
		font-size: 1rem;
		font-weight: 600;
	}

	.page-number {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 38px;
		height: 38px;
		padding: 0 14px;
		border-radius: 20px;
		background-color: rgb(var(--gray-light));
		box-shadow: inset 0 1px 0 rgba(var(--shadow), 5%);
		color: rgb(var(--black));
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	/* The current page and hovered links get a darker fill, as on the live site */
	a.page-number:hover,
	.page-number.current {
		background-color: rgba(var(--gray), 30%);
		background-color: color-mix(in srgb, rgb(var(--gray-light)), rgb(var(--black)) 10%);
		box-shadow: 0 1px 0 rgba(var(--shadow), 5%);
		color: rgb(var(--black));
	}

	.page-dots {
		display: inline-flex;
		align-items: center;
		height: 38px;
		color: rgb(var(--gray));
	}
</style>
