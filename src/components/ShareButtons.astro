---
interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const fbHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const xHref = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
---

<div class="share-buttons">
	<a
		class="share-button share-button-facebook"
		href={fbHref}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={`Share "${title}" on Facebook`}
	>
		<span class="share-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="currentColor">
				<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
			</svg>
		</span>
		<span class="share-label"><strong>SHARE</strong> ON FACEBOOK</span>
		<span class="share-plus" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
				<line x1="12" y1="5" x2="12" y2="19"/>
				<line x1="5" y1="12" x2="19" y2="12"/>
			</svg>
		</span>
	</a>

	<a
		class="share-button share-button-x"
		href={xHref}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={`Share "${title}" on X`}
	>
		<span class="share-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="currentColor">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
			</svg>
		</span>
		<span class="share-label"><strong>SHARE</strong> ON X</span>
		<span class="share-plus" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
				<line x1="12" y1="5" x2="12" y2="19"/>
				<line x1="5" y1="12" x2="19" y2="12"/>
			</svg>
		</span>
	</a>
</div>

<style>
	.share-buttons {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5em;
		margin: 1.5em 0;
	}

	.share-button {
		display: flex;
		align-items: center;
		gap: 0.85em;
		padding: 0.55em 0.55em 0.55em 1.1em;
		border-radius: 999px;
		text-decoration: none;
		color: white;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		transition: filter 0.15s ease, transform 0.15s ease;
	}

	.share-button:hover {
		filter: brightness(1.08);
	}

	.share-button:active {
		transform: scale(0.98);
	}

	.share-button-facebook {
		background: #3b5378;
	}

	.share-button-x {
		background: #5cb8e6;
	}

	.share-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.share-icon svg {
		width: 26px;
		height: 26px;
	}

	.share-label {
		flex: 1;
		font-size: 0.95rem;
	}

	.share-label strong {
		font-weight: 800;
	}

	.share-plus {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.22);
		flex-shrink: 0;
	}

	.share-plus svg {
		width: 18px;
		height: 18px;
		color: white;
	}

	@media (max-width: 600px) {
		.share-buttons {
			grid-template-columns: 1fr;
			gap: 0.75em;
		}
	}
</style>
