---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { SITE_TITLE, SITE_URL, SITE_AUTHOR } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  article?: boolean;
  pubDate?: Date;
  modDate?: Date;
  author?: string;
  keywords?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image,
  article = false,
  pubDate,
  modDate,
  author = SITE_AUTHOR,
  keywords = [],
} = Astro.props;

const imageUrl = image
  ? new URL(image.src, Astro.url)
  : new URL("/og-image.jpg", Astro.url);

// Structured Data (JSON-LD)
const structuredData =
  article && pubDate
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description: description,
        image: imageUrl.toString(),
        datePublished: pubDate.toISOString(),
        dateModified: (modDate || pubDate).toISOString(),
        author: {
          "@type": "Person",
          name: author,
          url: SITE_URL,
        },
        publisher: {
          "@type": "Organization",
          name: SITE_TITLE,
          logo: {
            "@type": "ImageObject",
            url: new URL("/logo.png", Astro.url).toString(),
          },
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url.toString(),
        },
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE_TITLE,
        url: SITE_URL,
        description: description,
        publisher: {
          "@type": "Organization",
          name: SITE_TITLE,
          logo: {
            "@type": "ImageObject",
            url: new URL("/logo.png", Astro.url).toString(),
          },
        },
      };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link
  rel="preload"
  href="/fonts/atkinson-regular.woff"
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/atkinson-bold.woff"
  as="font"
  type="font/woff"
  crossorigin
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={SITE_TITLE} />
{
  article && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  article && modDate && (
    <meta property="article:modified_time" content={modDate.toISOString()} />
  )
}
{article && <meta property="article:author" content={author} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
<meta name="twitter:creator" content="@wisdomgeek" />
<meta name="twitter:site" content="@wisdomgeek" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="language" content="English" />
<meta name="revisit-after" content="7 days" />
<link rel="author" href="/about" />

<!-- Structured Data (JSON-LD) -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>
