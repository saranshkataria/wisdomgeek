---
const today = new Date();
---

<footer>
	<button id="scroll-to-top" aria-label="Scroll to top">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M4.5 15 12 7.5l7.5 7.5"></path>
		</svg>
	</button>
	<p>Wisdom Geek &copy; {today.getFullYear()}. All Rights Reserved.</p>
</footer>

<script>
	const scrollButton = document.getElementById('scroll-to-top');

	if (scrollButton) {
		scrollButton.addEventListener('click', () => {
			window.scrollTo({
				top: 0,
				behavior: 'smooth'
			});
		});
	}
</script>

<style>
	/* As on the live site: a box as wide as the content with rounded top
	   corners, a back-to-top tab hanging from its top edge and a blue to
	   purple line near its bottom edge */
	footer {
		position: relative;
		max-width: 1200px;
		margin: 0 auto;
		padding-bottom: 70px;
		background-color: var(--surface-muted);
		border-radius: 20px 20px 0 0;
		box-shadow: inset 0 1px 0 rgba(var(--shadow), 5%);
		text-align: center;
	}

	footer::after {
		content: "";
		position: absolute;
		right: 0;
		bottom: 20px;
		left: 0;
		height: 5px;
		background-image: linear-gradient(90deg, #0d42a2, #6c5dd3);
	}

	footer p {
		margin: 0;
		padding: 20px 50px;
		color: rgb(var(--gray));
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	#scroll-to-top {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		box-sizing: border-box;
		width: 62px;
		height: 51px;
		margin: 0 auto;
		padding: 3px 0 0;
		border: 1px solid rgb(var(--gray-light));
		border-top: none;
		border-radius: 0 0 10px 10px;
		background: none;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: color 0.15s ease;
	}

	#scroll-to-top svg {
		width: 38px;
		height: 38px;
	}

	#scroll-to-top:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		footer p {
			padding: 50px 20px;
		}
	}
</style>
