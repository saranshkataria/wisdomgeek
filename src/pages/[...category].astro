---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import PageLayout from '../components/PageLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import PostGrid from '../components/PostGrid.astro';
import Pagination from '../components/Pagination.astro';
import {
	getArchiveTitle,
	getCategoryArchives,
	getCategoryNames,
	getFlatCategoryPaths,
	paginate,
} from '../lib/utils';

export const getStaticPaths = (async () => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	const categoryNames = getCategoryNames(posts);

	// /<category path>/ and /<category path>/page/<n>/, as on the live site
	const archivePages = [...getCategoryArchives(posts)].flatMap(([categoryPath, archivePosts]) =>
		paginate(archivePosts, `/${categoryPath}/`).map((page) => ({
			params: {
				category: page.currentPage === 1 ? categoryPath : `${categoryPath}/page/${page.currentPage}`,
			},
			props: {
				categoryName: categoryNames.get(categoryPath) ?? categoryPath,
				page,
			},
		})),
	);

	// Flat URLs such as /javascript/ duplicate a category archive (here
	// /development/web-development/javascript/). They render that archive, so
	// their canonical URL is the archive's.
	const flatPages = [...getFlatCategoryPaths(posts)].map(([slug, categoryPath]) => ({
		params: { category: slug },
		props: { rewrite: `/${categoryPath}/` },
	}));

	return [...archivePages, ...flatPages];
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const props = Astro.props;
if ('rewrite' in props) {
	return Astro.rewrite(props.rewrite);
}
const { categoryName, page } = props;
const title = getArchiveTitle(categoryName, page.currentPage);
const description = `All blog posts categorized under ${categoryName}`;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<PageLayout>
			<PageTitle icon="folder">{categoryName}</PageTitle>
			<PostGrid posts={page.data} />
			<Pagination page={page} />
		</PageLayout>
	</body>
</html>
