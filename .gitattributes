# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.astro text eol=lf
*.css text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
